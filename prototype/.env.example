# VisionGuard — Environment Variables
# Copy this file to .env and fill in your values.

# Gemini API Key (for voice commands and AI narration)
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# RTSP Camera Credentials (for IP cameras over PoE)
# These are used in config.py to build RTSP URLs without hardcoding passwords.
RTSP_USER=admin
RTSP_PASS=

# Web Dashboard Authentication
VISIONGUARD_USER=admin
VISIONGUARD_PASS=visionguard
